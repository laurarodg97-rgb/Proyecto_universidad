# Copie este archivo como .env y ajuste los valores.
# desarrollo | produccion
ENTORNO=desarrollo
LOG_LEVEL=INFO
# SQLite en local; en la nube puede ser una URL de PostgreSQL
DATABASE_URL=sqlite:///./simulaciones.db
# |brecha| en mil millones que cuenta como equilibrio
TOLERANCIA_EQUILIBRIO_MM=0.5
MAX_ESCENARIOS_MONTECARLO=5000
# Solo para el tablero
BACKEND_URL=http://localhost:8000
# Solo para scripts/preparar_agregados.py (la base nunca se sube)
RUTA_DATOS=
